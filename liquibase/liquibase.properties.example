# Copy to liquibase.properties (gitignored) and fill via env. Never commit real creds.
# host = the instance read_write DNS endpoint for your Lakebase project/branch.
url=jdbc:postgresql://your-lakebase-endpoint.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
username=${LAKEBASE_USER}
password=${LAKEBASE_PASSWORD}
# There is no single changelog: the pipeline runs ONE generated changelog PER table
# (liquibase/generated/<name>.changelog.sql), so scripts/deploy.sh passes --changeLogFile per
# table instead of a fixed value here. Regenerate with `python3 liquibase/generate_changelogs.py`.
liquibase.hub.mode=off
